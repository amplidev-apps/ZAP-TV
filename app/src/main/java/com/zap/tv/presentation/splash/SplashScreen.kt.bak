package com.zap.tv.presentation.splash

import androidx.compose.foundation.background
import androidx.compose.foundation.layout.*
import androidx.compose.material3.CircularProgressIndicator
import androidx.compose.material3.Text
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.unit.dp
import androidx.compose.ui.unit.sp
import androidx.hilt.navigation.compose.hiltViewModel

@Composable
fun SplashScreen(
    onSetupNeeded: () -> Unit,
    onReady: () -> Unit
) {
    val vm: SplashViewModel = hiltViewModel()
    var state by remember { mutableStateOf("Carregando...") }
    var error by remember { mutableStateOf<String?>(null) }
    var errorDetail by remember { mutableStateOf<String?>(null) }
    LaunchedEffect(Unit) {
        try {
            state = "Verificando configuração..."
            val needSetup = kotlinx.coroutines.withTimeout(6000) { vm.isSetupNeeded() }
            if (needSetup) { onSetupNeeded(); return@LaunchedEffect }
            state = "Sintonizando canais..."
            onReady()
        } catch (e: Exception) {
            error = "Erro na inicialização"
            errorDetail = "${e::class.java.simpleName}: ${e.message}\n${e.stackTrace.take(8).joinToString("\n")}"
            state = errorDetail ?: ""
            kotlinx.coroutines.delay(2500)
            try { onSetupNeeded() } catch (_: Exception) {}
        }
    }
    LaunchedEffect(Unit) {
        kotlinx.coroutines.delay(8000)
        if (error == null && (state == "Carregando..." || state == "Verificando configuração...")) {
            error = "Timeout"
            errorDetail = "Travou em verificação. Indo para configuração."
            onSetupNeeded()
        }
    }
    Box(Modifier.fillMaxSize().background(Color.Black), contentAlignment = Alignment.Center) {
        if (error != null) {
            Column(modifier = Modifier.fillMaxSize().padding(32.dp), horizontalAlignment = Alignment.CenterHorizontally, verticalArrangement = Arrangement.Center) {
                Text("ZAP-TV — Erro", color = Color(0xFFFF5252), fontSize = 28.sp, fontWeight = FontWeight.Black)
                Spacer(Modifier.height(12.dp))
                Text(errorDetail ?: "", color = Color.White, fontSize = 13.sp)
                Spacer(Modifier.height(16.dp))
                androidx.compose.material3.Button(onClick = { onSetupNeeded() }, colors = androidx.compose.material3.ButtonDefaults.buttonColors(containerColor = Color(0xFFFFD600), contentColor = Color.Black)) {
                    Text("Ir para Configuração")
                }
                Spacer(Modifier.height(8.dp))
                Text(state, color = Color(0xFFBDBDBD), fontSize = 12.sp)
            }
        } else {
            Column(horizontalAlignment = Alignment.CenterHorizontally) {
                Text("ZAP-TV", color = Color(0xFFFFD600), fontSize = 48.sp, fontWeight = FontWeight.Black)
                Spacer(Modifier.height(16.dp))
                CircularProgressIndicator(color = Color(0xFFFFD600))
                Spacer(Modifier.height(16.dp))
                Text(state, color = Color.White, fontSize = 18.sp)
            }
        }
    }
}
